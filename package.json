{
  "name": "scrollout",
  "version": "1.0.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Free, private full-page screenshots and editing for Chrome.",
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "build:check": "tsc --noEmit && node scripts/build.mjs --verify",
    "security": "npm audit --audit-level=low && node scripts/audit-artifacts.mjs",
    "security:site": "node scripts/security-site.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets": "node scripts/brand.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.49.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "fontkit": "^2.0.4",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.3"
  }
}
